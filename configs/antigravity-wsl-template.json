{
  "userSettings": {
    "globalPermissionGrants": {
      "allow": [
        "command(cmake)",
        "command(cmake *)",
        "command(ninja)",
        "command(ninja *)",
        "command(ctest)",
        "command(ctest *)",
        "command(g++)",
        "command(g++ *)",
        "command(clang++)",
        "command(clang++ *)",
        "command(conda)",
        "command(conda *)",
        "command(pytest)",
        "command(pytest *)",
        "command(python)",
        "command(python *)",
        "command(python3)",
        "command(python3 *)",
        "command(uv)",
        "command(uv *)",
        "command(ruff)",
        "command(ruff *)",
        "command(mypy)",
        "command(mypy *)",
        "command(node)",
        "command(node *)",
        "command(npm)",
        "command(npm *)",
        "command(npx)",
        "command(npx *)",
        "command(git)",
        "command(git *)",
        "command(gh)",
        "command(gh *)"
      ],
      "ask": [
        "command(*rm *.gemini*)",
        "command(*rm *antigravity*)",
        "command(*deploy.py*--prune*)",
        "command(git push --prune*)",
        "command(git push * --prune*)",
        "command(*git push --prune*)",
        "command(*git push * --prune*)",
        "command(curl -X POST *)"
      ],
      "deny": [
        "command(shutdown *)",
        "command(git reset --hard*)",
        "command(*git reset --hard*)",
        "command(git clean*)",
        "command(*git clean*)",
        "command(git push --force)",
        "command(git push --force *)",
        "command(git push * --force)",
        "command(git push * --force *)",
        "command(*git push --force)",
        "command(*git push --force *)",
        "command(*git push * --force)",
        "command(*git push * --force *)",
        "command(git push -f)",
        "command(git push -f *)",
        "command(git push * -f)",
        "command(git push * -f *)",
        "command(*git push -f)",
        "command(*git push -f *)",
        "command(*git push * -f)",
        "command(*git push * -f *)",
        "command(rm -rf /)",
        "command(rm -rf /*)",
        "command(rm -rf ~*)",
        "command(rm -rf $HOME*)",
        "command(rm -rf /mnt/*)",
        "command(*rm -rf /mnt/c/*)",
        "command(*rm -rf /mnt/d/*)",
        "command(*rm -r /mnt/c/*)",
        "command(*rm -r /mnt/d/*)",
        "command(*shutil.rmtree*)",
        "read_file({home}/.ssh/)",
        "read_file({home}/.aws/)",
        "write_file(/etc/)",
        "write_file(/boot/)",
        "write_file(/root/)"
      ]
    }
  }
}
